// Assignment 10 function
void funct10(char Server[], int color) { // HANDLE h hata diya hai

int range=0, arr[100], box;
char inp;

// Title replacement
cout << "\033]0;Data sorting\007"; 
cout<<"\n\n\t\t Data sorting /ascending to descending wise \n";

usleep(100000); // Sleep(100) -> usleep(100000)

cout << "\033[1;33m"; // SetConsoleTextAttribute(h,6) -> Yellow
cout<<"\n\t\tEnter your data randomly:\n\n";
cout << "\033[0m"; // SetConsoleTextAttribute(h,7) -> Reset/White

cout<<"\t\tFirst define your range:";
cin>>range;

// Note: arr[range] line fuzool thi is liye hata di, arr[100] pehle hi upar hai.

//inserting data 
for(int ind_entry=0; ind_entry<range; ind_entry++){
cout << "\033[2J\033[1;1H"; // system("cls") replacement
cout << "\033[1;32m"; // SetConsoleTextAttribute(h,2) -> Green
cout<<"\n\t\t\t Data entry "<<ind_entry+1<<" \n";
cout << "\033[0m"; // Reset
cout<<"\n\tEnter value no "<<ind_entry+1<<" :";   //entery getting msg
cin>>arr[ind_entry];
}

for (int ind_b = 0; ind_b < range - 1; ind_b++) {
        // ind_c ko ind_b + 1 se shuru karein
        for (int ind_c = ind_b + 1; ind_c < range; ind_c++) {
            if (arr[ind_b] > arr[ind_c]) {
                // Swapping
                box = arr[ind_b];
                arr[ind_b] = arr[ind_c];
                arr[ind_c] = box;
            }
        }
    }

    //checking
cout<<"\n\n\tIf you can see your output data press 's'\n\t";
cout<<"If you can exit Press 'e'";

// APK terminal ke liye cin use kiya hai taake getch ka masla na ho
cin >> inp;

if(inp=='s'|| inp=='S'){

cout << "\033[2J\033[1;1H"; // system("cls")
cout << "\033[1;32m"; // Green
cout<<"\n\t\t\t Data showing \n";
cout << "\033[0m"; // Reset


for(int ind_by=0; ind_by<range; ind_by++){

if(ind_by==0){cout<<"\n\t[ "<<arr[ind_by]; }
else if(ind_by==range-1){cout<<" , "<<arr[ind_by]<<"]";}
else{cout<<" , "<<arr[ind_by];}

}//loop close

}//condition 's' close
else if(inp=='e'||inp=='E'){
exit(0);
}

            ///finish
cout << "\n\nPress any key to continue...";
cin >> inp; // getch() replacement
last_destination(Server, color);
}
///server last display
void last_destination(char Server[], int color) { // HANDLE h hata diya hai

cout << "\033]0;Server explorer\007"; // SetConsoleTitle replacement
int inp;
cout << "\033[2J\033[1;1H"; // system("cls") replacement

cout<<"\n\n\t\t Main menu \n\n";
usleep(300000); // Sleep(300)
cout<<"\t1.Array get /give machine.\t\t Server:";

// Color setting for Server name
if(color == 2) cout << "\033[1;32m";      // Green
else if(color == 4) cout << "\033[1;31m"; // Red
else if(color == 6) cout << "\033[1;33m"; // Yellow
else cout << "\033[0m";                   // Default

cout<<Server;
cout << "\033[0m"; // SetConsoleTextAttribute(h,7) -> Reset

cout << "\n\t2.  Sum of Array Numbers Machine.";
cout << "\n\t3.  Find Largest Number in Array Machine.";
cout << "\n\t4.  Reverse the Array List Machine.";
cout << "\n\t5.  Separate Odd and Even Numbers Machine.";
cout << "\n\t6.  Create and Save New Records Machine.";
cout << "\n\t7.  Resize and Sort Array Machine.";
cout << "\n\t8.  Find Smallest Number in Array Machine.";
cout << "\n\t9.  Search Student in Classroom Machine.";
cout << "\n\t10. Sort Numbers in Ascending Order Machine.";
cout << "\n\t11. << Go Back to Server";
cout << "\n\t12.  Exit software";
cout << "\n\t\tSelecting option press only (1-12):";
cin>>inp;

switch(inp){
    case 1: funct1(Server,color); break;
    case 2: funct2(Server,color); break;
    case 3: funct3(Server,color); break;
    case 4: funct4(Server,color); break;
    case 5: funct5(Server,color); break;
    case 6: funct6(Server,color); break;
    case 7: funct7(Server,color); break;
    case 8: funct8(Server,color); break;
    case 9: funct9(Server,color); break;
    case 10: funct10(Server,color); break;
    case 11: main_main(); break;
    case 12: exit(0);
    default:
        cout << "\033[2J\033[1;1H"; 
        cout<<"\n\n\t<System Security authority Team Protocol>\n";
        cout<<"\tYou can press invalid key\n\tPress any key to go back";
        char temp; 
        cin >> temp; // getch() replacement
        last_destination(Server,color);
}

}//function close

void main_main() {
    
    char server[7][30] = {"US (England)","India (Gujrat)","Pakistan (Islamabad)","Mexico","America (London)","China","Exit"};
    char spinner[4] = {'|', '/', '-', '\\'};
    char Server_option;
    
    // APK terminal colors ke liye ANSI codes (properties)
    const char* ansi_colors[7] = {"\033[1;34m", "\033[1;33m", "\033[1;32m", "\033[1;35m", "\033[1;30m", "\033[1;31m", "\033[0m"};
    
    int delays[7]={200,300,100,400,500,150,50};
    int n = sizeof(spinner)/sizeof(spinner[0]);

    // SetConsoleTitle ki jagah ANSI property
    cout << "\033]0;Servering menu\007"; 
    
    // HANDLE h ko remove kiya kyunke ye Windows property hai
    bool repeat = true;
        while(repeat){
        // system("cls") ki jagah ANSI clear property
        cout << "\033[2J\033[1;1H"; 
        cout<<"\n\t\t\tServer Connecting machine\n";
        cout<<"\tServer Selection:\n";

        for(int ind_1=0; ind_1<7; ind_1++){
            cout<<"\t"<<ind_1+1;
            usleep(delays[ind_1] * 1000); // Sleep ki jagah usleep property
            
            // SetConsoleTextAttribute ki jagah ANSI color property
            cout << ansi_colors[ind_1];
            cout<<"_"<<server[ind_1]<<"\n";
            cout << "\033[0m"; // Reset color
        }

        cout<<"Press number: ";
        // getch() ki jagah cin property (APK compatibility ke liye)
        cin >> Server_option;

        // spinner animation
        for(int i = 0; i < 40; i++){ 
            cout << "\rPress number " << spinner[i % n] << flush; 
            usleep(50000); // Sleep(50) replacement
        }

        cout << "\033[2J\033[1;1H";

        if(Server_option=='7'){
            cout<<"You can go back\n";
            repeat = false;
        }
        else if(Server_option>='1' && Server_option<='6'){
            // fake connecting animation
            cout<<"\n\n\t";
            char connecting[20]="Connecting";
            long delays_2[10]={350,500,250,300,600,100,200,100,350,200};
            for(int ini_2=0; ini_2<10; ini_2++){
                usleep(delays_2[ini_2] * 1000);
                cout<<connecting[ini_2]<<flush;
            }
            cout << endl;

            // call sending request (Bina HANDLE h ke)
            int selected_idx = Server_option - '1';
            // Note: color index pass ho raha hai
            sending_Request(server[selected_idx], selected_idx); 
        }
        else{
            cout<<"\n\tInvalid operation";
            cout<<" Press any key to go back";
            char temp; cin >> temp; // getch() replacement
        }
    }//while close
}
// -----main function ------//
int main(){

char decision;
restr:
    // HANDLE h ko remove kiya kyunke ye Windows property hai
    
    // SetConsoleTitle ki jagah ANSI property
    cout << "\033]0;Tevta interface\007"; 
    
    // system("cls") ki jagah ANSI clear
    cout << "\033[2J\033[1;1H"; 
    
    usleep(1000000); // Sleep(1000) -> 1 second delay

    cout << "\033[1;32m"; // SetConsoleTextAttribute(h,2) -> Green
    cout<<"\n\t\t\t\tTevta ILT Center";
    
    cout << "\033[0m"; // SetConsoleTextAttribute(h,7) -> Reset/White
    cout<<"\n\n\t>>This software is a functional programming assignment.";
    cout<<"\n\n\tYou can use this software follow those steps";
    
    cout << "\033[1;33m"; // SetConsoleTextAttribute(h,6) -> Yellow
    cout<<"\n\t1.Selecting server type their number\n\t2.Next open your machine";
    
    cout << "\033[0m"; // Reset to White
    cout<<"\n\n\tIf you get their code you type 'g' in lowercase\n\t";
    cout<<"Press any key to start the program\n\tIf we click 'q' you can quit";
    
    // getch() ki jagah cin property
    cin >> decision;

if(decision=='g'){
    char inp;
    cout << "\033]0;Assignment code\007"; // Title
    cout << "\033[2J\033[1;1H"; // Clear Screen
    cout<<"\n\t\tAssignment code:\n";
    cout<<"\tDirect function start\n";
    cout<<"\n\tIf you go back press 'b'\n\t";
    cout<<"If you quit press any key.";
    
    cin >> inp; // getch() replacement
    if(inp=='b'){goto restr;}
}
else if(decision=='q'){
    exit(0);
}
else{
    main_main();
}
return 0;
}
