// Assignment 5 function

void funct5(char Server[],int color){ // HANDLE h hata diya hai

int arr[range],serperate[2][5];
char inp; // int inp ko char kiya hai
int ind_odd=0,ind_even=0;

        // Windows specific settings ka replacement
cout << "\033]0;Machine no 5\007"; 
cout << "\033[2J\033[1;1H"; 

cout<<"\n\t\tSeparate Odd and Even Numbers Machine\n";
cout<<"\tEnter your number list one by one:";
getingArray(arr,range);

                    //processing
        //seperating odd even
for(int ind_b=0;ind_b<range;ind_b++){
if(arr[ind_b]%2==0){
serperate[1][ind_even]=arr[ind_b] ;   
    ind_even+=1;
}
else{
    serperate[0][ind_odd]=arr[ind_b];   
     ind_odd+=1;
}

}//loop close
cout<<"\n\n\tIf you can see your output data press 's'\n\t";
cout<<"If you can exit Press 'e'";
                    //input see exit
cin >> inp; // getch() ki jagah cin


//output
if(inp=='s'|| inp=='S'){
int range_f=2;
int child_range=1;

for(int ind_c=0;ind_c<range_f;ind_c++){
usleep(500000); // Sleep(500)
cout << "\033[1;31m"; // SetConsoleTextAttribute(h,4) -> Red color
    if(ind_c==0){
child_range=ind_odd;
cout<<"\nOdd :";
    }
    else{
child_range=ind_even;
cout<<"\nEven :";
    }
cout << "\033[0m"; // SetConsoleTextAttribute(h,7) -> White/Reset
for(int ind_d=0;ind_d<child_range;ind_d++){
usleep(80000); // Sleep(80)
cout<<"\n~ Index # ["<<ind_c<<"]["<<ind_d<<"] Value is :"<<serperate[ind_c][ind_d];
}
cout<<"\n";
}

cout << "\n\nPress any key to continue...";
cin >> inp; // getch() replacement
} //if condition


else if(inp=='e'||inp=='E'){
exit(0);
}
 last_destination(Server,color);
}
