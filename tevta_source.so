// Assignment 8 function

void funct8(char Server[], int color) { // HANDLE h hata diya hai

int range = 5;
int arr[5]; // arr[range] ko 5 kar diya hai safety ke liye
char inp;
int box;

   // Windows settings replacement
cout << "\033]0;Machine no 8\007"; // SetConsoleTitle
cout << "\033[2J\033[1;1H"; // system("cls")


cout<<"\n\t\t Find Smallest Number in Array Machine ";
cout<<"\n\n\t\tEnter your numaric values list:\n";
for(int ind_a=0; ind_a<range; ind_a++){
    cout<<"\n\t\tEnter your number"<<ind_a+1<<" :";
    cin>>arr[ind_a];
}

// finding smallest number
for(int ind_b=0; ind_b<range; ind_b++){
                    // Checking indexs are available
for(int ind_c=0; ind_c < range - 1; ind_c++){ // ind_c < range - 1 kiya hai taake crash na ho

if(arr[ind_c] > arr[ind_c+1]){
box=arr[ind_c];
arr[ind_c]=arr[ind_c+1];
arr[ind_c+1]=box;
}

}

}
cout<<"\n\n\tIf you can see your output data press 's'\n\t";
cout<<"If you can exit Press 'e'";

// APK terminal ke liye cin use kiya hai
cin >> inp;

usleep(500000); // Sleep(500) ki jagah usleep

if(inp=='s'|| inp=='S'){
cout<<"\n\n\tSmallest number :";
cout << "\033[1;33m"; // SetConsoleTextAttribute(h,6) -> Yellow
cout<<arr[0];
cout << "\033[0m"; // Reset to white
}

else if(inp=='e'||inp=='E'){
exit(0);
}

// finish
cout << "\n\nPress any key to continue...";
cin >> inp; // getch() replacement
last_destination(Server, color);
}

