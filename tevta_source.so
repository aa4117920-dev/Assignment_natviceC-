    cout<<"\n\tEnter your number"<<ind_a+1<<" :";
    cin>>arr[ind_a];
}
// finding largest number
for(int ind_b=0;ind_b<5;ind_b++){
                    // Checking indexs are available
for(int ind_c=0;ind_c<5;ind_c++){

if(arr[ind_c]<arr[ind_c+1]){
box=arr[ind_c];
arr[ind_c]=arr[ind_c+1];
arr[ind_c+1]=box;
}

}

}
